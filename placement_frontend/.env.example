# Placement Preparation Platform - Frontend Environment Variables

# Backend API URL (Points to the standalone placement_backend service)
NEXT_PUBLIC_API_URL="http://localhost:5000"

# Application Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_TIMEZONE="Asia/Kolkata"

# Session & Edge Auth Configuration
COOKIE_NAME="ppp_session"
JWT_SECRET="placement-prep-super-secret-jwt-key-32-chars-minimum-2026"
